# Vost environment — copy to `.env` (docker compose / local runs).

# ---- server (runtime) ----------------------------------------------------
# Port the Node server listens on.
PORT=8787

# Bind address. Use 127.0.0.1 when a reverse proxy (nginx, caddy, traefik)
# sits in front; 0.0.0.0 to expose directly.
HOST=0.0.0.0

# ---- client (build time — Vite bakes these into the bundle) --------------
# true  -> skip the server proxy and call Binance/Yahoo/Stooq directly.
#          Only Binance sends CORS headers; use this for static-only hosting
#          of the offline (CSV/Demo) workflow or crypto-only charting.
# unset -> use /api/proxy on the Vost server (default; all providers work).
# VITE_DIRECT=false

# Path prefix of the proxy route.
# VITE_PROXY_PREFIX=/api/proxy

# ---- dev only -------------------------------------------------------------
# Where the Vite dev server proxies /api/* (default http://localhost:8787).
# VOST_SERVER_URL=http://localhost:8787
